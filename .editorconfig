# EditorConfig: https://editorconfig.org
# 共通の編集ルール（タブ幅・改行コード・文字コード）をエディタ間で揃える

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java / Kotlin: 4 スペース（業界標準）
[*.{java,kt,kts,gradle}]
indent_size = 4

# Python: 4 スペース（PEP 8）
[*.{py,pyi}]
indent_size = 4

# Markdown: 末尾空白は意味があるので保持（2スペースで改行）
[*.{md,markdown}]
trim_trailing_whitespace = false

# Makefile: タブ必須
[Makefile]
indent_style = tab

# Windows バッチファイル: CRLF
[*.{bat,cmd}]
end_of_line = crlf
