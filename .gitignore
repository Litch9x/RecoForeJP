# ============================================================
# RecoForeJP - .gitignore
# ============================================================

# --- OS / Editor -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Claude Code 設定（個人別）
.claude/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# --- Office 一時ファイル ----------------------------------------------
~$*
*.tmp
*.bak

# ルート直下に残った旧版ドキュメント（不要・Word ロック中）
/Processs.docx
/論文.docx

# --- Node.js / Frontend / API Gateway ---------------------------------
node_modules/
.next/
.turbo/
.nuxt/
out/
build/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
.env
.env.local
.env.*.local

# --- Python / AI Service ----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.eggs/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Java / Spring Boot (user-service, item-service) ------------------
target/
build/
*.class
*.jar
*.war
.gradle/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties
.classpath
.project
.settings/
out/
bin/

# --- Docker / Infra ---------------------------------------------------
*.pid
*.lock
docker-compose.override.yml

# --- ML / Data --------------------------------------------------------
*.pt
*.pth
*.h5
*.ckpt
*.onnx
data/
models/
*.csv.gz
*.parquet

# --- Secrets ----------------------------------------------------------
*.pem
*.key
secrets/
.env.production

# 評価スクリプトの出力（毎回再生成）
eval-results.json
