# RecoForeJP - 環境変数サンプル
# このファイルを .env としてコピーし、必要に応じて値を変更してください:
#   cp infra/.env.example infra/.env

# ---------- PostgreSQL ----------
POSTGRES_USER=reco
POSTGRES_PASSWORD=reco_password
POSTGRES_DB=reco
POSTGRES_PORT=5432

# 各サービスから接続する際の URL（参考）
# DATABASE_URL=postgresql://reco:reco_password@localhost:5432/reco

# ---------- Redis ----------
REDIS_PORT=6379

# 各サービスから接続する際の URL（参考）
# REDIS_URL=redis://localhost:6379
